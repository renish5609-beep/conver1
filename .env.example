ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# ElevenLabs Speech Engine — true speech-to-speech for Voice Session, Cold
# Open, and Debate. Also requires ELEVENLABS_API_KEY (see below). Created via
# el.speechEngine.create()/update() — see the Speech Engine section of
# server.js for how it's attached. Must be set in every environment that
# actually runs server.js — this project deploys on Render.
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# One Speech Engine resource per voice (Speech Engine's client-override
# policy only supports overriding the first message, not the TTS voice —
# confirmed against the live API — so coach/gender voice variety needs a
# separate fixed-voice engine per voice rather than one shared engine).
# SPEECH_ENGINE_ID is the legacy/fallback single-voice var, kept as the
# default if SPEECH_ENGINE_ID_BLAZE isn't set.
SPEECH_ENGINE_ID=seng_your-speech-engine-id-here
SPEECH_ENGINE_ID_BLAZE=seng_your-blaze-engine-id-here
SPEECH_ENGINE_ID_ECHO=seng_your-echo-engine-id-here
SPEECH_ENGINE_ID_SAGE=seng_your-sage-engine-id-here
SPEECH_ENGINE_ID_NOVA=seng_your-nova-engine-id-here
SPEECH_ENGINE_ID_REX=seng_your-rex-engine-id-here
SPEECH_ENGINE_ID_LUNA=seng_your-luna-engine-id-here

# Cold Open's full voice pool (6 female + 7 male) — one engine per voice,
# not one per gender, so different Cold Open characters of the same gender
# don't all sound identical. Picked randomly client-side per session by
# pickColdOpenVoiceKey() in index.html, matching gender.
SPEECH_ENGINE_ID_CF1=seng_your-coldopen-female-1-engine-id-here
SPEECH_ENGINE_ID_CF2=seng_your-coldopen-female-2-engine-id-here
SPEECH_ENGINE_ID_CF3=seng_your-coldopen-female-3-engine-id-here
SPEECH_ENGINE_ID_CF4=seng_your-coldopen-female-4-engine-id-here
SPEECH_ENGINE_ID_CF5=seng_your-coldopen-female-5-engine-id-here
SPEECH_ENGINE_ID_CF6=seng_your-coldopen-female-6-engine-id-here
SPEECH_ENGINE_ID_CM1=seng_your-coldopen-male-1-engine-id-here
SPEECH_ENGINE_ID_CM2=seng_your-coldopen-male-2-engine-id-here
SPEECH_ENGINE_ID_CM3=seng_your-coldopen-male-3-engine-id-here
SPEECH_ENGINE_ID_CM4=seng_your-coldopen-male-4-engine-id-here
SPEECH_ENGINE_ID_CM5=seng_your-coldopen-male-5-engine-id-here
SPEECH_ENGINE_ID_CM6=seng_your-coldopen-male-6-engine-id-here
SPEECH_ENGINE_ID_CM7=seng_your-coldopen-male-7-engine-id-here
