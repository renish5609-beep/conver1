ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# ElevenLabs Speech Engine — true speech-to-speech for Voice Session, Cold
# Open, and Debate. Also requires ELEVENLABS_API_KEY (see below). Created via
# el.speechEngine.create()/update() — see the Speech Engine section of
# server.js for how it's attached. Must be set in every environment that
# actually runs server.js — this project deploys on Render.
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# One Speech Engine resource per voice (Speech Engine's client-override
# policy only supports overriding the first message, not the TTS voice —
# confirmed against the live API — so coach/gender voice variety needs a
# separate fixed-voice engine per voice rather than one shared engine).
# SPEECH_ENGINE_ID is the legacy/fallback single-voice var, kept as the
# default if SPEECH_ENGINE_ID_BLAZE isn't set.
SPEECH_ENGINE_ID=seng_your-speech-engine-id-here
SPEECH_ENGINE_ID_BLAZE=seng_your-blaze-engine-id-here
SPEECH_ENGINE_ID_ECHO=seng_your-echo-engine-id-here
SPEECH_ENGINE_ID_SAGE=seng_your-sage-engine-id-here
SPEECH_ENGINE_ID_NOVA=seng_your-nova-engine-id-here
SPEECH_ENGINE_ID_REX=seng_your-rex-engine-id-here
SPEECH_ENGINE_ID_LUNA=seng_your-luna-engine-id-here
SPEECH_ENGINE_ID_COLDOPEN_FEMALE=seng_your-coldopen-female-engine-id-here
SPEECH_ENGINE_ID_COLDOPEN_MALE=seng_your-coldopen-male-engine-id-here
