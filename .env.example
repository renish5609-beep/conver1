ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# ElevenLabs Speech Engine — true speech-to-speech for Voice Session, Cold
# Open, and Debate. This is the ONLY var needed for it — the server
# self-provisions every voice (6 coaches + 13 Cold Open pool voices) on
# boot, looking up already-existing "Conver Speech Engine — <name>"
# resources by name and creating only what's missing. No per-voice env vars
# to manage by hand (a prior version of this required 19 of them; that was
# real, actually-hit friction — one missed var silently fell back to a
# single shared voice for everyone). See provisionSpeechEngines() in
# server.js.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
